{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "lib": ["ES2023"],
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "rootDir": ".",
    "outDir": "build"
  },
  "include": ["server/**/*.ts", "server/**/*.mjs", "cli/**/*.ts"],
  "exclude": ["**/*.test.*", "server/test-support/**"]
}
