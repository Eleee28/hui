{
  "name": "hui",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "description": "HarnessUI — a Lit-based control surface for coding agent harnesses",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin/hui.mjs",
    "build/",
    "dist/",
    "THIRD_PARTY_NOTICES.md",
    "desktop/*.cjs",
    "desktop/*.mjs",
    "!desktop/*.test.mjs"
  ],
  "bin": {
    "hui": "bin/hui.mjs"
  },
  "scripts": {
    "dev": "node bin/hui-dev.mjs gateway",
    "desktop": "npm run build && node bin/hui.mjs desktop",
    "build": "node scripts/build.mjs",
    "api:schema": "node scripts/api-schema.ts",
    "prepack": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:package": "npm run build && node --test e2e/package.test.ts",
    "e2e:sdk": "node e2e/sdk-backend.mjs",
    "e2e:package": "node e2e/package-browser.mjs",
    "eval:jira-draft": "node evals/jira-draft/run.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "postinstall": "node desktop/install.mjs --postinstall"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@gespenst/core": "0.1.2",
    "@lezer/highlight": "1.2.5",
    "@lydell/node-pty": "1.2.0-beta.15",
    "electron": "44.4.5",
    "katex": "0.18.9",
    "lit": "^3.3.3",
    "markdown-it": "15.0.2",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.0.0",
    "typebox": "1.3.34",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.2",
    "@types/ws": "8.18.1",
    "dd-trace": "6.20.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  }
}
